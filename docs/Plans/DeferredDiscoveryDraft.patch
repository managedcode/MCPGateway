+++ b/src/ManagedCode.MCPGateway/Catalog/Internal/Descriptors/McpGatewayDefinitionFingerprint.cs
@@ -0,0 +1,35 @@
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+
+namespace ManagedCode.MCPGateway;
+
+public static class McpGatewayDefinitionFingerprint
+{
+    private const string UnserializableDefinitionMessage = "Catalog definition cannot be serialized.";
+    public static string Compute(object definition)
+    {
+        ArgumentNullException.ThrowIfNull(definition);
+        var node = McpGatewayJsonSerializer.TrySerializeToNode(definition) ?? throw new JsonException(UnserializableDefinitionMessage);
+        var canonical = Canonicalize(node);
+        return Convert.ToHexStringLower(SHA256.HashData(Encoding.UTF8.GetBytes(canonical.ToJsonString(McpGatewayJsonSerializer.Options))));
+    }
+
+    private static JsonNode Canonicalize(JsonNode node)
+    {
+        if (node is JsonObject obj)
+        {
+            var sorted = new JsonObject();
+            foreach (var pair in obj.OrderBy(static item => item.Key, StringComparer.Ordinal)) sorted[pair.Key] = pair.Value is null ? null : Canonicalize(pair.Value);
+            return sorted;
+        }
+        if (node is JsonArray array)
+        {
+            var result = new JsonArray();
+            foreach (var item in array) result.Add(item is null ? null : Canonicalize(item));
+            return result;
+        }
+        return node.DeepClone();
+    }
+}
