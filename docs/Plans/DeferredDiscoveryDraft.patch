diff --git a/src/ManagedCode.MCPGateway/Catalog/Internal/Descriptors/McpGatewayDefinitionFingerprint.cs b/src/ManagedCode.MCPGateway/Catalog/Internal/Descriptors/McpGatewayDefinitionFingerprint.cs
