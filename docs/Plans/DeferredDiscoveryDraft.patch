@@ -0,0 +1,26 @@
+using System.Text.Json;
+using ManagedCode.MCPGateway.Abstractions;
+using Microsoft.Extensions.AI;
+
+namespace ManagedCode.MCPGateway;
+
+internal sealed class McpGatewaySchemaFunction(IMcpGateway gateway, McpGatewaySearchMatch match, string functionName) : AIFunction
+{
+    private const string MissingSchemaMessage = "A schema-preserving discovered tool requires an input schema.";
+    private readonly JsonElement _schema = match.InputSchema?.Clone() ?? throw new InvalidOperationException(MissingSchemaMessage);
+    public override string Name => functionName;
+    public override string Description => match.Description;
+    public override JsonElement JsonSchema => _schema;
+    public override JsonSerializerOptions JsonSerializerOptions => McpGatewayJsonSerializer.Options;
+    public override IReadOnlyDictionary<string, object?> AdditionalProperties { get; } = new Dictionary<string, object?>
+    {
+        [McpGatewayToolSet.DiscoveredToolIdPropertyName] = match.ToolId,
+        [McpGatewayToolSet.DiscoveredToolSourceIdPropertyName] = match.SourceId,
+    };
+
+    protected override async ValueTask<object?> InvokeCoreAsync(AIFunctionArguments arguments, CancellationToken cancellationToken)
+    {
+        var result = await gateway.InvokeAsync(new McpGatewayInvokeRequest(ToolId: match.ToolId, Arguments: arguments), cancellationToken).ConfigureAwait(false);
+        return McpGatewayJsonSerializer.TrySerializeToElement(result);
+    }
+}
diff --git a/src/ManagedCode.MCPGateway/Discovery/McpGatewayDiscovery.cs b/src/ManagedCode.MCPGateway/Discovery/McpGatewayDiscovery.cs
new file mode 100644
--- /dev/null
+++ b/src/ManagedCode.MCPGateway/Discovery/McpGatewayDiscovery.cs
@@ -0,0 +1,62 @@
+using System.Text;
+using ManagedCode.MCPGateway.Abstractions;
+
+namespace ManagedCode.MCPGateway;
+
+public sealed class McpGatewayDiscovery(IMcpGateway gateway)
+{
+    private const int MaximumSummaryCharacters = 512;
+    private const string SchemaNotFoundMessage = "Tool schema is unavailable.";
+
+    public async Task<McpGatewayToolSchema?> GetSchemaAsync(string toolId, CancellationToken cancellationToken = default)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(toolId);
+        var descriptors = await gateway.ListToolsAsync(cancellationToken).ConfigureAwait(false);
+        var descriptor = descriptors.FirstOrDefault(tool => string.Equals(tool.ToolId, toolId, StringComparison.OrdinalIgnoreCase));
+        if (descriptor is null) return null;
+        if (descriptor.InputSchema.ValueKind == System.Text.Json.JsonValueKind.Undefined) throw new InvalidOperationException(SchemaNotFoundMessage);
+        return new(descriptor.ToolId, descriptor.SourceId, descriptor.InputSchema.Clone(), descriptor.OutputSchema?.Clone(), McpGatewayDefinitionFingerprint.Compute(descriptor.InputSchema));
+    }
+
+    public async Task<McpGatewayDiscoveryResult> SearchAsync(McpGatewayDiscoveryRequest request, CancellationToken cancellationToken = default)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+        ArgumentOutOfRangeException.ThrowIfLessThan(request.MaxBytes, McpGatewayDiscoveryRequest.MinimumMaximumBytes);
+        ArgumentOutOfRangeException.ThrowIfNegativeOrZero(request.MaxResults);
+        var search = await gateway.SearchAsync(new McpGatewaySearchRequest(request.Query, request.MaxResults)
+        {
+            SourceId = request.SourceId,
+            Category = request.Category,
+        }, cancellationToken).ConfigureAwait(false);
+        var primary = new List<McpGatewayToolSummary>();
+        var related = new List<McpGatewayToolSummary>();
+        var nextSteps = new List<McpGatewayToolSummary>();
+        var result = new McpGatewayDiscoveryResult(primary, related, nextSteps, false);
+        var omitted = AddSummaries(search.Matches, primary, result, request.MaxBytes);
+        omitted |= AddSummaries(search.RelatedMatches, related, result, request.MaxBytes);
+        omitted |= AddSummaries(search.NextStepMatches, nextSteps, result, request.MaxBytes);
+        result = result with { HasMore = omitted };
+        for (var iteration = 0; iteration < 3; iteration++) result = result with { DeliveredBytes = Measure(result) };
+        return result;
+    }
+
+    private static bool AddSummaries(IReadOnlyList<McpGatewaySearchMatch> matches, List<McpGatewayToolSummary> target, McpGatewayDiscoveryResult result, int budget)
+    {
+        var omitted = false;
+        foreach (var match in matches)
+        {
+            var length = Math.Min(match.Description.Length, MaximumSummaryCharacters);
+            if (length > 0 && char.IsHighSurrogate(match.Description[length - 1])) length--;
+            target.Add(new(match.ToolId, match.SourceId, match.Description[..length], match.Score)
+            { IsReadOnly = match.IsReadOnly, IsDestructive = match.IsDestructive });
+            if (Measure(result with { HasMore = true, DeliveredBytes = budget }) > budget)
+            {
+                target.RemoveAt(target.Count - 1);
+                omitted = true;
+            }
+        }
+        return omitted;
+    }
+
+    private static int Measure(McpGatewayDiscoveryResult result) => Encoding.UTF8.GetByteCount(McpGatewayJsonSerializer.TrySerializeToElement(result)!.Value.GetRawText());
+}
